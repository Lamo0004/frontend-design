---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    grid-column: 1 / -1;
    scroll-snap-type: inline mandatory; /* stopper scrolling */

    list-style: none; 
    display: flex;
    gap: var(--card-gap);
    overflow-x: auto;

    padding-inline: max(20px, 50% - var(--content-width) / 2);
    scroll-padding-inline-start: max(20px, 50% - var(--content-width) / 2); /* Udgangspunktet i scroll */

    li {
      flex-basis: min(90%, 400px);
      flex-shrink: 0;

      scroll-snap-align: start; /* Hvor den placerer kortet vd stop scroll */

      padding: var(--card-padding);
      background-color: var(--card-background);
      color: var(--card-text-color);
      border-radius: var(--card-border-radius);
    }
  }

</style>
